{
  "name": "unicorn-pig-reminder",
  "version": "1.1.1",
  "private": true,
  "author": "Lantern",
  "description": "Unicorn pig（by lantern）完全离线桌面活动提醒器",
  "main": "electron/main.js",
  "scripts": {
    "build:web": "node scripts/build-standalone.mjs",
    "test": "node --test tests/*.test.cjs",
    "start": "npm run build:web && electron .",
    "pack:win": "npm run build:web && electron-builder --win portable --x64",
    "pack:mac": "npm run build:web && electron-builder --mac zip"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lantern.unicorn-pig",
    "productName": "Unicorn pig (by lantern)",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "Unicorn-pig-by-lantern-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": ["zip"],
      "category": "public.app-category.productivity",
      "artifactName": "Unicorn-pig-by-lantern-${version}-${arch}.${ext}"
    }
  }
}
